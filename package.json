{
  "name": "vetagent",
  "version": "1.0.0",
  "description": "Vet your AI coding agent setup in one command \u2014 secrets, permissions, hooks, MCP servers, skills and hygiene, 100% local.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "vetagent": "dist/cli.js",
    "agentvet": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "keywords": [
    "claude-code",
    "codex",
    "ai-agent",
    "security",
    "audit",
    "mcp",
    "secrets",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LucasXlab/vetagent.git"
  },
  "homepage": "https://github.com/LucasXlab/vetagent#readme",
  "bugs": {
    "url": "https://github.com/LucasXlab/vetagent/issues"
  }
}
